{
  // Terminal > Run Task... > "Release: bump version and push" publishes main to the live site
  // (raises the version, commits "Version X.Y.Z", pushes). See tools/release.mjs.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Release: bump version and push",
      "type": "npm",
      "script": "release",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": true
      }
    }
  ]
}
